generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" //shubhamthakur25 insted of prisma
   url      = "postgresql://shubhamthakur25:ankushthakur@localhost:5432/postgres"
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  FirstName String
  LastName String? //optional then put this sign
  password String
}

model Todo {
  id Int @id @default(autoincrement())
  title String
  done Boolean @default(false)
  description String?
  userId Int
}